# Authentication uses HTTP-only cookies; no token belongs in Vite environment variables.
# Optional API base URL for production when backend is hosted on a separate origin/subdomain (defaults to /api).
# VITE_API_URL=https://api.seudominio.com/api
# Optional development proxy target (defaults to http://127.0.0.1:8000).
# Set this in the shell running Vite, e.g. QUESTIO_API_PROXY=http://127.0.0.1:8000 npm run dev
